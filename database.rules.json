{
  "rules": {

    "liveRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $roomId"
      }
    },

    "liveSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveSignal": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "livePresence": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $hostUid"
      }
    },

    "studioLiveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $hostUid"
      }
    },

    "guestRequests": {
      "$roomId": {
        ".read": "auth != null && auth.uid == $roomId",
        "$guestUid": {
          ".read":  "auth != null && (auth.uid == $roomId || auth.uid == $guestUid)",
          ".write": "auth != null && (auth.uid == $guestUid || auth.uid == $roomId)"
        }
      }
    },

    "guestSignaling": {
      "$roomId": {
        ".read":  "auth != null && auth.uid == $roomId",
        "$guestUid": {
          ".read":  "auth != null && (auth.uid == $roomId || auth.uid == $guestUid)",
          ".write": "auth != null && (auth.uid == $roomId || auth.uid == $guestUid)"
        }
      }
    },

    "liveGuests": {
      "$roomId": {
        ".read": "auth != null",
        "$guestUid": {
          ".write": "auth != null && (auth.uid == $roomId || auth.uid == $guestUid)"
        }
      }
    },

    "guestViewerSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "stormRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "supportRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "presence": {
      "cloudStream": {
        "$streamId": {
          ".read":  "auth != null",
          "$sessionId": {
            ".write": "auth != null"
          }
        }
      },
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "nexusViewers": {
      "$channelId": {
        ".read":  "auth != null",
        "$sessionId": {
          ".write": "auth != null"
        }
      }
    },

    "userLive": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }

  }
}
